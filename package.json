{
  "name": "minionah-bot",
  "type": "module",
  "version": "0.0.1",
  "dependencies": {
    "@prisma/client": "^6.16.3",
    "discord.js": "^14.22.1",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "node-cache": "^5.1.2",
    "node-cron": "^4.2.1",
    "prisma": "^6.16.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/compat": "^1.4.0",
    "@types/express": "^5.0.3",
    "eslint": "^9.36.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.4.0",
    "nodemon": "^3.1.10",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.45.0"
  },
  "scripts": {
    "prod": "bun ./src",
    "dev": "bunx nodemon -e ts --watch 'src/**/*.ts' --exec 'bun ./src'",
    "dev:prod": "dotenv -e .env -- bunx nodemon -e ts --watch 'src/**/*.ts' --exec 'bun ./src'",
    "lint": "prettier --check . && eslint .",
    "format": "prettier --write ."
  },
  "engines": {
    "node": "^22",
    "pnpm": "forbidden, use bun instead",
    "deno": "forbidden, use bun instead",
    "npm": "forbidden, use bun instead",
    "yarn": "forbidden, use bun instead",
    "bun": "^1"
  }
}
