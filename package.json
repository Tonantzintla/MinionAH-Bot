{
  "name": "minionah-bot",
  "type": "module",
  "version": "0.0.1",
  "dependencies": {
    "@prisma/client": "^6.7.0",
    "discord.js": "^14.19.3",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "node-cache": "^5.1.2",
    "prisma": "^6.7.0",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@types/express": "^5.0.1",
    "nodemon": "^3.1.10",
    "typescript": "^5.8.3"
  },
  "scripts": {
    "prod": "bun ./src",
    "dev": "bunx nodemon -e ts --watch 'src/**/*.ts' --exec 'bun ./src'",
    "dev:prod": "dotenv -e .env -- bunx nodemon -e ts --watch 'src/**/*.ts' --exec 'bun ./src'"
  }
}
