generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

model User {
  id           String              @id
  loggedInAt   DateTime            @default(now()) @updatedAt
  createdAt    DateTime            @default(now())
  syncedAt     DateTime?
  username     String              @unique
  auctions     Auction[]
  chatsAsUser1 Chat[]              @relation("user1")
  chatsAsUser2 Chat[]              @relation("user2")
  key          Key[]
  messages     Message[]
  sessions     Session[]
  oauth        UserOAuthProvider[]
  settings     UserSettings?
}

model UserOAuthProvider {
  id               String    @id @unique
  userId           String
  provider         String
  providerUsername String
  syncedAt         DateTime? @default(now())
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model UserSettings {
  id                   String                @id
  user_id              String                @unique
  notificationSettings NotificationSettings?
  profileSettings      ProfileSettings?
  user                 User                  @relation(fields: [id], references: [id], onDelete: Cascade)
}

model ProfileSettings {
  id           String       @id
  email        String?
  bio          String?
  urls         String[]
  userSettings UserSettings @relation(fields: [id], references: [user_id], onDelete: Cascade)
}

model NotificationSettings {
  id                  String           @id
  notificationType    NotificationType
  marketNotifications Boolean          @default(true)
  socialNotifications Boolean          @default(true)
  fcmTokens           String[]
  userSettings        UserSettings     @relation(fields: [id], references: [user_id], onDelete: Cascade)
}

model Session {
  id        String   @id
  userId    String
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Key {
  id              String  @id
  hashed_password String?
  user_id         String
  user            User    @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
}

model Minion {
  id             String    @id
  name           String
  generator      String
  generator_tier Int
  maxTier        Int
  craftCost      Float     @default(0)
  sellers        Auction[]
}

model Auction {
  id          String    @id @default(cuid())
  minion_id   String
  user_id     String
  hasInfusion Boolean   @default(false)
  hasFreeWill Boolean   @default(false)
  price       Float
  amount      Int
  timeCreated DateTime  @default(now()) @updatedAt
  timeBumped  DateTime?
  timeEmailed DateTime?
  minion      Minion    @relation(fields: [minion_id], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([minion_id])
}

model Chat {
  id           String    @id @default(cuid())
  user1_id     String
  user2_id     String
  createdAt    DateTime  @default(now())
  user1Read    Boolean   @default(false)
  user2Read    Boolean   @default(false)
  user1Emailed Boolean   @default(false)
  user2Emailed Boolean   @default(false)
  user1        User      @relation("user1", fields: [user1_id], references: [id], onDelete: Cascade)
  user2        User      @relation("user2", fields: [user2_id], references: [id], onDelete: Cascade)
  messages     Message[]
}

model Message {
  id        String      @id @default(cuid())
  chat_id   String
  user_id   String
  content   String
  type      MessageType @default(TEXT)
  createdAt DateTime    @default(now())
  chat      Chat        @relation(fields: [chat_id], references: [id], onDelete: Cascade)
  user      User        @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([chat_id])
  @@index([user_id])
}

enum NotificationType {
  ALL
  EMAIL
  DEVICE
  NONE
}

enum MessageType {
  TEXT
  AUCTION
}
