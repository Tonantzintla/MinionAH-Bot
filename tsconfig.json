{
  "compilerOptions": {
    "target": "es2022",
    "module": "es2022",
    "esModuleInterop": true,
    "outDir": "dist",
    "rootDir": "src",
    "moduleResolution": "node",
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "paths": {
      "$generated/*": ["./src/generated/*"],
      "$lib/*": ["./src/lib/*"],
      "$src/*": ["./src/*"],
      "$rest/*": ["./src/rest/*"],

    }
  },
}